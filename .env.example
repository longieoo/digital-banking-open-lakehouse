# Replace fake placeholders locally; never commit .env.
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=bank
PGHOST=postgres
PGPORT=5432
PGDATABASE=bank
PGUSER=bank_admin
PGPASSWORD=replace-with-local-password
MINIO_ROOT_USER=replace-with-local-user
MINIO_ROOT_PASSWORD=replace-with-local-password
AWS_ACCESS_KEY_ID=replace-with-local-user
AWS_SECRET_ACCESS_KEY=replace-with-local-password
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
CATALOG_URI=http://catalog:8181
RAW_URI=s3://raw
WAREHOUSE_URI=s3://warehouse
STORAGE_BACKEND=s3
CONTROL_PATH=/opt/bank/runtime/control.db
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=transformer
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
RISK_AMOUNT_THRESHOLD=10000.00
# Cloud uses workload/managed identity or externally supplied service principal.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

AIRFLOW_ADMIN_USER=demo_admin
AIRFLOW_ADMIN_PASSWORD=replace-with-local-password

# Optional loopback-only consumption and monitoring ports.
BANK_BI_PORT=8090
BANK_METRICS_PORT=9091
