-- Import into a real Power BI model using the table names in bi/README.md.
Customers = DISTINCTCOUNT(mart_customer_360[customer_id])
Accounts = DISTINCTCOUNT(dim_account[account_id])
Transaction Count = COUNTROWS(fct_transactions)
Transaction Value =
    IF(HASONEVALUE(dim_currency[currency]), SUM(fct_transactions[amount]), BLANK())
Posted Transaction Value =
    IF(HASONEVALUE(dim_currency[currency]),
        CALCULATE(SUM(fct_transactions[amount]), fct_transactions[status] = "SUCCESS"), BLANK())
Net Posted Movement =
    IF(HASONEVALUE(dim_currency[currency]), SUM(fct_transactions[signed_amount]), BLANK())
Successful Transactions = CALCULATE([Transaction Count], fct_transactions[status] = "SUCCESS")
Success Rate = DIVIDE([Successful Transactions], [Transaction Count], 0)
Total Balance =
    VAR LastVisibleDate = MAX(fct_account_balance_daily[business_date])
    RETURN IF(HASONEVALUE(dim_currency[currency]),
        CALCULATE(SUM(fct_account_balance_daily[closing_balance]),
        fct_account_balance_daily[business_date] = LastVisibleDate), BLANK())
Reconciliation Failures =
    CALCULATE(COUNTROWS(mart_reconciliation_daily), mart_reconciliation_daily[reconciliation_status] = "FAIL")
